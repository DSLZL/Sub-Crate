# Copy to .env beside docker-compose.example.yml before starting Compose.
# The native executable does not load .env files automatically.

# Compose settings. Pin a release tag; change to sub-crate:local for a source build.
SUB_CRATE_IMAGE=ghcr.io/dslzl/sub-crate:v0.0.1
SUB_CRATE_BIND=127.0.0.1
SUB_CRATE_PORT=3000

# Runtime settings. Compose fixes the internal listener at 0.0.0.0:3000
# and the writable data path at /data, backed by ./data on the host.
NODE_ENV=production
TZ=Asia/Taipei
SUB_STORE_BODY_JSON_LIMIT=1mb

# Empty keeps the built-in origins, including https://sub-store.vercel.app.
# To override, provide the complete comma-separated list of allowed origins.
SUB_STORE_CORS_ALLOWED_ORIGINS=
# SUB_STORE_BACKEND_CUSTOM_NAME=Sub-Crate
# SUB_STORE_X_POWERED_BY=Sub-Crate

# Optional backend URL prefix. Any nonempty value (even false) enables the flag;
# comment it out or leave it empty to disable it.
# SUB_STORE_BACKEND_PREFIX=true
# SUB_STORE_FRONTEND_BACKEND_PATH=/backend

# Optional merged frontend: also uncomment the /frontend mount in Compose.
# Set all three variables together. No frontend is built or bundled in the image.
# SUB_STORE_FRONTEND_PATH=/frontend
# SUB_STORE_BACKEND_MERGE=true
# SUB_STORE_FRONTEND_BACKEND_PATH=/backend

# Optional schedules: second minute hour day month weekday, in TZ above.
# Gist backup schedules use provider settings saved through the frontend.
# SUB_STORE_BACKEND_SYNC_CRON='0 0 */6 * * *'
# SUB_STORE_BACKEND_UPLOAD_CRON='0 0 3 * * *'
# SUB_STORE_BACKEND_DOWNLOAD_CRON='0 30 3 * * *'
# SUB_STORE_PRODUCE_CRON='0 0 */6 * * *,sub,example'

# Optional MMDB refresh. Set each URL and its matching writable path together.
# SUB_STORE_MMDB_COUNTRY_URL=
# SUB_STORE_MMDB_COUNTRY_PATH=/data/GeoLite2-Country.mmdb
# SUB_STORE_MMDB_ASN_URL=
# SUB_STORE_MMDB_ASN_PATH=/data/GeoLite2-ASN.mmdb
# SUB_STORE_MMDB_CRON='0 0 4 * * *'

# Optional startup restore: a nonempty URL imports data on every startup.
# Leave disabled when retaining the existing ./data directory.
# SUB_STORE_DATA_URL=
# SUB_STORE_DATA_URL_POST=
